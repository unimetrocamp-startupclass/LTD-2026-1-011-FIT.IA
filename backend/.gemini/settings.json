{
  "context": {
    "fileName": [
      "GEMINI.md",
      "CODEX.md"
    ]
  },
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "codex"
      ],
      "trust": false
    },
    "context7": {
      "command": "C:\\nvm4w\\nodejs\\node.exe",
      "args": [
        "C:\\Users\\rafae\\AppData\\Roaming\\npm\\node_modules\\@upstash\\context7-mcp\\dist\\index.js",
        "--transport",
        "stdio"
      ],
      "env": {
        "MCP_PASSWORD": "$MCP_PASSWORD",
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-$MCP_PASSWORD}"
      },
      "timeout": 40000,
      "trust": false
    },
    "perplexity": {
      "command": "cmd",
      "args": [
        "/c",
        "set",
        "PERPLEXITY_API_KEY=%MCP_PASSWORD%",
        "&&",
        "npx",
        "-y",
        "@perplexity-ai/mcp-server"
      ],
      "env": {
        "MCP_PASSWORD": "$MCP_PASSWORD"
      },
      "timeout": 30000,
      "trust": false
    }
  }
}
